{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": ["src/**/*", "bin/**/*"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "jest"],
    "paths": {
      "@bot/*": ["./src/bot/*"],
      "@config/*": ["./src/config/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@tictactoe/*": ["./src/tictactoe/*"]
    },
    "incremental": true,
    "declaration": true,
    "stripInternal": true
  }
}
