{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["src/**/*", "bin/**/*", "vitest.config.mts", "vitest.setup.ts"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@bot/*": ["./src/bot/*"],
      "@config/*": ["./src/config/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@tictactoe/*": ["./src/tictactoe/*"]
    },
    "incremental": true,
    "declaration": true,
    "stripInternal": true
  }
}
